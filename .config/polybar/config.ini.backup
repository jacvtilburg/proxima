[colors]
background = #802A0B12
foreground = #FFF0E9
red = #FF786B
burgundy = #69252D
orange = #E69B86
yellow = #FFD0A0

[bar/proxima]
width = 100%
height = 26
offset-y = 0
bottom = false
fixed-center = true
background = #802A0B12
foreground = ${colors.foreground}
line-size = 2
line-color = ${colors.red}
border-size = 0
padding-left = 2
padding-right = 2
module-margin = 1
font-0 = JetBrainsMono Nerd Font:size=9;1
modules-left = wifi bluetooth vpn
modules-center = clock
modules-right = volume battery
enable-ipc = true
pseudo-transparency = false

[module/wifi]
type = custom/text
content = "󰤨"
content-foreground = #FF786B
click-left = nm-connection-editor
content-background = #1B0B0E
content-underline = #69252D
content-padding = 2
content-margin = 1


[module/bluetooth]
type = custom/text
content = "󰂯"
content-foreground = #FF786B
click-left = blueman-manager
content-background = #1B0B0E
content-underline = #69252D
content-padding = 2
content-margin = 1


[module/vpn]
type = custom/text
content = "󰦝"
content-foreground = #FF786B
click-left = nm-connection-editor
content-background = #1B0B0E
content-underline = #69252D
content-padding = 2
content-margin = 1


[module/clock]
type = internal/date
interval = 1
time = %H:%M:%S
date = %A, %d %B
label = %time%  %date%
label-foreground = ${colors.yellow}

[module/volume]
type = internal/pulseaudio
format-volume = <ramp-volume> <label-volume>
label-volume = %percentage%%
label-volume-foreground = ${colors.orange}
label-muted = 󰝟 muted
label-muted-foreground = ${colors.red}
ramp-volume-0 = 󰕿
ramp-volume-1 = 󰖀
ramp-volume-2 = 󰕾
click-right = pavucontrol
click-left = pactl set-sink-mute @DEFAULT_SINK@ toggle
scroll-up = pactl set-sink-volume @DEFAULT_SINK@ +5%
scroll-down = pactl set-sink-volume @DEFAULT_SINK@ -5%

[module/battery]
type = internal/battery
battery = BAT0
adapter = AC
poll-interval = 5
format-charging = <label-charging>
format-discharging = <label-discharging>
format-full = <label-full>
label-charging = 󰂄 %percentage%%
label-discharging = 󰁹 %percentage%%
label-full = 󰁹 %percentage%%
label-charging-foreground = ${colors.yellow}
label-discharging-foreground = ${colors.orange}
label-full-foreground = ${colors.red}
