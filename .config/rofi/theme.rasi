
/* ── Rofi Theme ──────────────────────────────
   Proxima Centauri b
   Red dwarf inspired colour palette
   ─────────────────────────────────────────── */

/* Global defaults */
* {
  font: "JetBrainsMono Nerd Font 11";
  blur: true;
  padding: 10px;
  background-color: transparent;
  border-radius: 0px;
}

/* ── Window ──────────────────────────────── */
window {
  width: 750px;
  height: 625px;
  location: center;
  blur: true;
  border: 2px;
  border-radius: 3px;
  border-color: #69252D;
  background-color: transparent;
  padding: 0px;
  margin: 30px 50px;
}

/* ── Layout ──────────────────────────────── */
mainbox {
  orientation: horizontal;
  children: [ "borderbox" ];
  spacing: 0px;
  padding: 0px;
}

borderbox {
  orientation: horizontal;
  children: [ "imagebox", "contentbox" ];
  padding: 0px;
  spacing: 0px;
  border-radius: 3px;
}

contentbox {
  orientation: vertical;
  children: [ "entry", "listview" ];
  spacing: 0px;
  padding: 0px;
  expand: true;
}

/* ── Imagebox ────────────────────────────── */
imagebox {
    background-image: url("/home/jesse/.config/rofi/image.jpeg");
    background-repeat: false;
    size: 300px 316px;
}

/* ── Elements ────────────────────────────── */
element {
  border-radius: 0px;
}

element-text, element-icon {
  padding: 6px 8px;
  spacing: 2px;
  text-color: #E69B86;
}

element selected {
  background-color: #40151C;
  text-color: #FFD0A0;
  border-radius: 3px;
}

/* ── Input & Prompt ──────────────────────── */
prompt {
  enabled: false;
  background-color: transparent;
  text-color: #FF786B;
  padding: 5px 10px;
}

entry {
  padding: 8px;
  expand: false;
  font: "JetBrainsMono Nerd Font 12";
  text-color: #FFF0E9;
  border-radius: 0px 3px 0px 0px;
  background-color: #1B0B0E;
}

/* ── Listview ────────────────────────────── */
listview {
  lines: 1;
  background-color: rgba(16, 7, 8, 0.8);
  border-radius: 0px 0px 3px 0px;
  padding: 5px;
}

